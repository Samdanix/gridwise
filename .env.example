# Copy to .env and fill in. NEVER commit a real key.
# Google AI Studio key for the operator-note interpretation stage.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional overrides (defaults shown).
GRIDWISE_LLM_MODEL=gemini-3.6-flash
GRIDWISE_LLM_TIMEOUT=12
GRIDWISE_LLM_ATTEMPTS=2
DJANGO_DEBUG=0
LOG_LEVEL=INFO
PORT=8000
